
@article{roman-roman_note_2019,
	title = {A {Note} on {Estimation} of {Multi}-{Sigmoidal} {Gompertz} {Functions} with {Random} {Noise}},
	volume = {7},
	copyright = {https://creativecommons.org/licenses/by/3.0/},
	issn = {2227-7390},
	url = {https://www.mdpi.com/2227-7390/7/6/541},
	doi = {10.3390/math7060541},
	abstract = {The behaviour of many dynamic real phenomena shows different phases, with each one following a sigmoidal type pattern. This requires studying sigmoidal curves with more than one inflection point. In this work, a diffusion process is introduced whose mean function is a curve of this type, concretely a transformation of the well-known Gompertz model after introducing in its expression a polynomial term. The maximum likelihood estimation of the parameters of the model is studied, and various criteria are provided for the selection of the degree of the polynomial when real situations are addressed. Finally, some simulated examples are presented.},
	language = {en},
	number = {6},
	urldate = {2026-11-16},
	journal = {Mathematics},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Román-Román, Patricia and Serrano-Pérez, Juan José and Torres-Ruiz, Francisco},
	month = jun,
	year = {2019},
	keywords = {diffusion processes, maximum likelihood estimation, model selection, multi-sigmoidal growth curves},
	pages = {541},
	file = {Full Text PDF:C\:\\Users\\hp\\Zotero\\storage\\PW3DSLVT\\Román-Román et al. - 2019 - A Note on Estimation of Multi-Sigmoidal Gompertz Functions with Random Noise.pdf:application/pdf},
}

