@article{narmontas_models_2020,
	title = {Models for {Tree} {Taper} {Form}: {The} {Gompertz} and {Vasicek} {Diffusion} {Processes} {Framework}},
	volume = {12},
	issn = {2073-8994},
	shorttitle = {Models for {Tree} {Taper} {Form}},
	url = {https://www.mdpi.com/2073-8994/12/1/80},
	doi = {10.3390/sym12010080},
	abstract = {In this work, we employ stochastic differential equations (SDEs) to model tree stem taper. SDE stem taper models have some theoretical advantages over the commonly employed regression-based stem taper modeling techniques, as SDE models have both simple analytic forms and a high level of accuracy. We perform fixed- and mixed-effect parameters estimation for the stem taper models by developing an approximated maximum likelihood procedure and using a data set of longitudinal measurements from 319 mountain pine trees. The symmetric Vasicek- and asymmetric Gompertz-type diffusion processes used adequately describe stem taper evolution. The proposed SDE stem taper models are compared to four regression stem taper equations and four volume equations. Overall, the best goodness-of-fit statistics are produced by the mixed-effect parameters SDEs stem taper models. All results are obtained in the Maple computer algebra system.},
	language = {en},
	number = {1},
	urldate = {2026-11-16},
	journal = {Symmetry},
	author = {Narmontas, Martynas and Rupšys, Petras and Petrauskas, Edmundas},
	month = jan,
	year = {2020},
	pages = {80},
	file = {Full Text:C\:\\Users\\hp\\Zotero\\storage\\WDW2RWGY\\Narmontas et al. - 2020 - Models for Tree Taper Form The Gompertz and Vasicek Diffusion Processes Framework.pdf:application/pdf},
}

